# Local development settings. Live settings live in Vercel → Settings → Environment Variables.

# Local MongoDB. On Vercel this is your Atlas connection string (the "amas" database is used either way).
MONGODB_URI=mongodb://127.0.0.1:27017

# Door staff type this once on their phone to check passes in. Use a long passphrase.
# Left empty locally, a temporary key is printed in the terminal on every start.
STAFF_KEY=

# Email. Leave SMTP_HOST empty locally: passes then go to a free Ethereal test inbox, never to real people.
# Live (Vercel) uses AWS SES Mail Manager: SMTP_HOST=<ingress endpoint>  SMTP_PORT=587  SMTP_USER=<inp-… id>  SMTP_PASS=<password>
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=alerts@yourdomain.org
# MAIL_FROM_NAME=AMAS Foundation

# BASE_URL is optional: it defaults to http://localhost:3000 locally and to the production domain on Vercel.
# Only set it for a custom domain. Never copy a localhost value to Vercel.
