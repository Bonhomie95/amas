# Public address of the site. It is baked into every QR code and email link, so set it to your real URL when you deploy.
BASE_URL=http://localhost:3000
PORT=3000

# Local MongoDB for now. Later, paste your Atlas connection string here (the "amas" database is used either way).
MONGODB_URI=mongodb://127.0.0.1:27017

# Door staff type this once on their phone to check passes in. Use a long passphrase.
# Left empty, a temporary key is printed in the terminal on every start.
STAFF_KEY=

# Email. Leave SMTP_HOST empty to use a free Ethereal test inbox (nothing is really delivered; preview links print in the terminal).
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="AMAS Foundation <tickets@yourdomain.org>"
